# Copie para .env (não versionado) ou configure no Render / Fly.io.

# Conexão com o Postgres do Supabase (Project Settings > Database > Connection string, modo "Transaction pooler").
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Project Settings > API
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Chave secreta (service_role ou sb_secret_...): só no servidor, nunca no site.
SUPABASE_SERVICE_ROLE_KEY=
# Só para projetos que ainda assinam o login com o segredo antigo (HS256). Deixe vazio para usar as chaves JWKS.
SUPABASE_JWT_SECRET=

# Endereços do site (CORS e links dos convites)
SITE_ORIGENS=http://localhost:3000
SITE_URL=http://localhost:3000

# Limites diários por aluno
LIMITE_MENSAGENS_DIA=60
LIMITE_AULAS_DIA=5

# Geração de aulas
ANTHROPIC_API_KEY=
