# Copie para .env.local (não versionado) ou configure no projeto da Vercel.
# Project Settings > API do Supabase: URL e chave pública (anon ou sb_publishable_...). Nunca a chave secreta.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endereço da API FastAPI (Render ou Fly.io)
NEXT_PUBLIC_API_URL=http://localhost:8000
