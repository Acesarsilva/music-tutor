{% if not fragmento %}
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{% endif %}
<title>{{ aula.titulo }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap">
<style>
{{ css | safe }}
</style>
{% if not fragmento %}
</head>
<body>
{% endif %}
<header class="barra">
  <div class="barra-interna">
    <p class="barra-aula"><span class="selo">{{ aula.codigo }}</span> {{ aula.titulo }}</p>
    <div class="controles">
      <div class="timbre" role="group" aria-label="Instrumento">
        <button type="button" id="timbre-piano" data-timbre="piano" aria-pressed="{{ 'true' if timbre == 'piano' else 'false' }}">Piano</button>
        <button type="button" id="timbre-violao" data-timbre="violao" aria-pressed="{{ 'true' if timbre == 'violao' else 'false' }}">Violão</button>
      </div>
      <label class="andamento" for="andamento">
        <span>Andamento</span>
        <input type="range" id="andamento" min="50" max="150" step="10" value="100">
        <output id="andamento-valor" for="andamento">100%</output>
      </label>
    </div>
  </div>
</header>

<main class="aula">
  <section class="abertura">
    <p class="rotulo">Teoria musical · {{ nivel_pt }}</p>
    <h1>{{ aula.titulo }}</h1>
    <p class="chamada">{{ aula.resumo_curto | md_linha | safe }}</p>
    <div class="ficha">
      <div>
        <h2 class="rotulo">Você vai aprender</h2>
        <ul>
        {% for objetivo in aula.objetivos %}
          <li>{{ objetivo | md_linha | safe }}</li>
        {% endfor %}
        </ul>
      </div>
      {% if aula.prerequisitos %}
      <div>
        <h2 class="rotulo">Antes, é bom saber</h2>
        <ul>
        {% for item in aula.prerequisitos %}
          <li>{{ item | md_linha | safe }}</li>
        {% endfor %}
        </ul>
      </div>
      {% endif %}
    </div>
    <nav class="indice" aria-label="Seções da aula">
      <ol>
      {% for secao in aula.secoes %}
        <li><a href="#secao-{{ loop.index }}">{{ secao.titulo }}</a></li>
      {% endfor %}
        <li><a href="#exercicios">Exercícios</a></li>
        <li><a href="#resumo">Resumo</a></li>
      </ol>
    </nav>
  </section>

  {% for secao in aula.secoes %}
  {% set i = loop.index0 %}
  <section class="secao" id="secao-{{ loop.index }}">
    <h2><span class="num">{{ loop.index }}</span>{{ secao.titulo }}</h2>
    {% for bloco in secao.blocos %}
    {% set j = loop.index0 %}
    {% if bloco.tipo == "texto" %}
    <div class="prosa">{{ bloco.markdown | md | safe }}</div>
    {% elif bloco.tipo == "dica" %}
    <aside class="dica"><p class="rotulo">Dica</p>{{ bloco.markdown | md | safe }}</aside>
    {% elif bloco.tipo == "exemplo" %}
    {% set ex = bloco.exemplo %}
    <figure class="exemplo" data-exemplo="{{ ex.id }}">
      <div class="exemplo-topo">
        <p class="exemplo-titulo">{{ ex.titulo }}</p>
        <button type="button" class="tocar" data-tocar="{{ ex.id }}"><span class="icone" aria-hidden="true"></span><span class="texto">Ouvir</span></button>
      </div>
      <div class="partitura" data-partitura="{{ ex.id }}"></div>
      <figcaption>{{ ex.legenda | md_linha | safe }}</figcaption>
    </figure>
    {% elif bloco.tipo == "tabela" %}
    <figure class="tabela">
      <div class="tabela-rolagem">
        <table>
          <thead><tr>{% for c in bloco.cabecalho %}<th scope="col">{{ c | md_linha | safe }}</th>{% endfor %}</tr></thead>
          <tbody>
          {% for linha in bloco.linhas %}
            <tr>{% for c in linha %}<td>{{ c | md_linha | safe }}</td>{% endfor %}</tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      <figcaption>{{ bloco.legenda | md_linha | safe }}</figcaption>
    </figure>
    {% elif bloco.tipo == "teclado" %}
    <figure class="bloco-teclado">
      <div class="teclado-rolagem"><div class="teclado" data-teclado="t-{{ i }}-{{ j }}"></div></div>
      <figcaption>
        <span>{{ bloco.legenda | md_linha | safe }}</span>
        <span class="acoes-instrumento">
          <button type="button" class="tocar pequeno" data-tocar-teclado="t-{{ i }}-{{ j }}"><span class="icone" aria-hidden="true"></span><span class="texto">Ouvir as notas</span></button>
          <button type="button" class="secundario" data-montar-acorde="t-{{ i }}-{{ j }}" aria-pressed="false">Montar acorde</button>
          <button type="button" class="tocar pequeno" data-tocar-acorde="t-{{ i }}-{{ j }}" hidden><span class="icone" aria-hidden="true"></span><span class="texto">Tocar juntas</span></button>
        </span>
      </figcaption>
    </figure>
    {% endif %}
    {% endfor %}
  </section>
  {% endfor %}

  <section class="secao exercicios" id="exercicios">
    <h2><span class="num">{{ aula.secoes | length + 1 }}</span>Exercícios</h2>
    <p class="placar" id="placar" aria-live="polite">Responda para ver seus acertos.</p>
    {% for exe in aula.exercicios %}
    {% set k = loop.index0 %}
    <article class="exercicio" data-exercicio="{{ k }}" data-tipo="{{ exe.tipo }}">
      <p class="rotulo">Exercício {{ loop.index }} · {% if exe.tipo == "multipla_escolha" %}Múltipla escolha{% elif exe.tipo == "percepcao" %}Percepção{% else %}Toque a nota{% endif %}</p>
      <div class="enunciado">{{ exe.enunciado | md | safe }}</div>
      {% if exe.tipo == "percepcao" %}
      <button type="button" class="tocar" data-tocar="{{ exe.exemplo.id }}"><span class="icone" aria-hidden="true"></span><span class="texto">Ouvir</span></button>
      <figure class="exemplo oculto" data-exemplo="{{ exe.exemplo.id }}" hidden>
        <div class="partitura" data-partitura="{{ exe.exemplo.id }}"></div>
        <figcaption>{{ exe.exemplo.legenda | md_linha | safe }}</figcaption>
      </figure>
      {% elif exe.tipo == "multipla_escolha" and exe.exemplo %}
      <figure class="exemplo" data-exemplo="{{ exe.exemplo.id }}">
        <div class="exemplo-topo">
          <p class="exemplo-titulo">{{ exe.exemplo.titulo }}</p>
          <button type="button" class="tocar" data-tocar="{{ exe.exemplo.id }}"><span class="icone" aria-hidden="true"></span><span class="texto">Ouvir</span></button>
        </div>
        <div class="partitura" data-partitura="{{ exe.exemplo.id }}"></div>
      </figure>
      {% endif %}
      {% if exe.tipo == "teclado" %}
      <div class="teclado-rolagem"><div class="teclado" data-teclado-exercicio="{{ k }}"></div></div>
      <div class="acoes-teclado">
        <button type="button" class="tocar pequeno" data-tocar-base="{{ k }}"><span class="icone" aria-hidden="true"></span><span class="texto">Ouvir a nota de partida</span></button>
      </div>
      {% else %}
      <ol class="opcoes" type="A">
      {% for opcao in exe.opcoes %}
        <li><button type="button" class="opcao" data-opcao="{{ loop.index0 }}">{{ opcao | md_linha | safe }}</button></li>
      {% endfor %}
      </ol>
      {% endif %}
      <div class="retorno" hidden>
        <p class="veredito"></p>
        <div class="explicacao">{{ exe.explicacao | md | safe }}</div>
      </div>
    </article>
    {% endfor %}
  </section>

  <section class="secao" id="resumo">
    <h2><span class="num">{{ aula.secoes | length + 2 }}</span>Resumo</h2>
    <ul class="resumo">
    {% for item in aula.resumo %}
      <li>{{ item | md_linha | safe }}</li>
    {% endfor %}
    </ul>
    <div class="para-o-chat">
      <p class="rotulo">Leve para o chat do professor</p>
      <p id="pergunta-chat">{{ aula.pergunta_para_chat }}</p>
      <button type="button" id="copiar-pergunta" class="secundario">Copiar pergunta</button>
    </div>
  </section>
</main>

<footer class="rodape">
  <p>Aula {{ aula.codigo }} · notas, intervalos e respostas conferidos com music21 · som gerado no navegador</p>
</footer>

<script type="application/json" id="dados-aula">{{ dados_json | safe }}</script>
<script src="https://cdn.jsdelivr.net/npm/abcjs@6.7.1/dist/abcjs-basic-min.js"></script>
<script>
{{ js | safe }}
</script>
{% if not fragmento %}
</body>
</html>
{% endif %}
